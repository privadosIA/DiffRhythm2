<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>diffrhythm2</AssemblyName>
    <RootNamespace>DiffRhythm2.Cli</RootNamespace>
    <!-- Allows running on machines that only have a newer runtime (e.g. .NET 10). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiffRhythm2.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiffRhythm2.Net\DiffRhythm2.Net.csproj" />
  </ItemGroup>

</Project>
